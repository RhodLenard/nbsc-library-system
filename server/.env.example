DATABASE_URL="mysql://library_app:local-development-password@localhost:3308/library_v2"
JWT_SECRET="local-development-secret-at-least-32-characters-long"
CORS_ORIGIN="http://localhost:5173"
PORT=3001
# Absolute path outside the application directory. In Docker, this is /backups
# and must be supplied through BACKUP_HOST_DIR in the compose environment.
BACKUP_DIR="C:\LibrarySystemBackups"
# Separate clean MariaDB database used only by the restore-test endpoint.
BACKUP_RESTORE_TEST_DATABASE_URL=""
